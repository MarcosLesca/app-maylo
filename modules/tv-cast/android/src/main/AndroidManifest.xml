<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Some Wi-Fi chipsets drop SSDP traffic unless a multicast lock is held. -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- SSDP goes out through the Wi-Fi network even when mobile data or a VPN is the default route. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Background control (S5): media-playback foreground service while a cast is active. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <!-- Partial wake lock and Wi-Fi lock so the proxy keeps serving with the screen off. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- The media notification (expo-notifications requests it at runtime too). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.tvcast.CastMediaService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
  </application>
</manifest>
